{
  "expo": {
    "name": "SkyWatchNEO",
    "slug": "SkyWatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nasa_sky_watch_icon_fixed.png",
    "scheme": "skywatch",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/nasa_sky_watch_icon_fixed.png",
      "bundleIdentifier": "com.austinzurbuchen.SkyWatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0d1a",
        "foregroundImage": "./assets/images/nasa_sky_watch_icon_fixed.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.austinzurbuchen.SkyWatch"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nasa_sky_watch_icon_fixed.png"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0d1a",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/nasa_sky_watch_icon_fixed.png",
          "color": "#0a0d1a",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2278565a-4661-4f41-8ace-7b36d4b24614"
      }
    },
    "owner": "austinzurbuchen"
  }
}
